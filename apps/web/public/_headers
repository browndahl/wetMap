/*
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://tiles.openfreemap.org https://*.openfreemap.org https://wetmap-api.wetmap-edge.workers.dev; img-src 'self' data: blob: https://tiles.openfreemap.org https://*.openfreemap.org https://wetmap-api.wetmap-edge.workers.dev; style-src 'self' 'unsafe-inline'; font-src 'self' data: https://tiles.openfreemap.org https://*.openfreemap.org; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
